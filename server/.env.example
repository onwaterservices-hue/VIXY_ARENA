# Server-side only. Copy to server/.env. NEVER commit server/.env.
PORT=8787
HOST=127.0.0.1
NODE_ENV=production
STATIC_DIR=dist
DATABASE_PATH=server/data/arena.db
SESSION_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES
COOKIE_SECURE=true
# APP_ORIGIN=https://arena.example.com      # only if the API is not same-origin with the app
SESSION_IDLE_MINUTES=10080
SESSION_ABSOLUTE_HOURS=720
DISCORD_REQUIRED=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
DISCORD_REDIRECT_URL=https://arena.example.com/api/auth/discord/callback
# ENGINE=demo (labeled simulator) | live (real Kalshi + Polymarket ingest, no model yet)
ENGINE=demo
ENGINE_REFRESH_SECONDS=30
PUBLIC_FEATURED=true
STRIPE_WEBHOOK_SECRET=
MAIL_MODE=outbox
MAIL_WEBHOOK_URL=
MAIL_FROM=VIXY ARENA <no-reply@example.com>

# --- backend production phase ---
# Discord verification lifetime. A verified link is re-asked every RECHECK_HOURS; older than MAX_AGE_HOURS → JOIN_DISCORD again.
# DISCORD_RECHECK_HOURS=24
# DISCORD_MAX_AGE_HOURS=336
# DISCORD_RECHECK_LOOP_MINUTES=15
# Stripe identity: checkout email is NOT an identity key. Only set true to allow an audited last-resort match to an existing account.
# STRIPE_EMAIL_FALLBACK=false
# Settlement sweep period (locks whose market has closed are asked about; outcomes come from the venue only).
# SETTLE_SWEEP_SECONDS=60
# The labeled simulator is refused in production unless you say so.
# ALLOW_DEMO_ENGINE_IN_PRODUCTION=false

# --- model phase ---
# consensus = vixy-arena-consensus-0.1.0 (the Arena's own model; constants UNVALIDATED, it says so on /api/model).
# none      = no model: every VIXY probability is null and no lock can be written. The production model never falls back to demo.
# MODEL=consensus
